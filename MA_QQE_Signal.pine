//@version=5
indicator("MA + QQE MOD Signal", overlay=true, max_labels_count=500)

// ══════════════════════════════════════════════════════════════════════════════
//  EMA
// ══════════════════════════════════════════════════════════════════════════════
grpMA      = "EMA"
ema50_len  = input.int(50,  "Periodo EMA 50",  minval=1, group=grpMA)
ema100_len = input.int(100, "Periodo EMA 100", minval=1, group=grpMA)
ema150_len = input.int(150, "Periodo EMA 150", minval=1, group=grpMA)
show_emas  = input.bool(true, "Mostra EMA", group=grpMA)

// ══════════════════════════════════════════════════════════════════════════════
//  QQE MOD
// ══════════════════════════════════════════════════════════════════════════════
grpQQE = "QQE MOD"
ql1    = input.int(14,     "RSI Length Lento",   minval=1,   group=grpQQE)
qs1    = input.int(5,      "RSI Smooth Lento",   minval=1,   group=grpQQE)
qf1    = input.float(4.238,"QQE Factor Lento",   minval=0.1, group=grpQQE)
ql2    = input.int(6,      "RSI Length Veloce",  minval=1,   group=grpQQE)
qs2    = input.int(5,      "RSI Smooth Veloce",  minval=1,   group=grpQQE)
qf2    = input.float(1.618,"QQE Factor Veloce",  minval=0.1, group=grpQQE)

// ══════════════════════════════════════════════════════════════════════════════
//  SEGNALE
// ══════════════════════════════════════════════════════════════════════════════
grpSig          = "Segnale"
dot_color_long  = input.color(color.yellow, "Colore Long",  group=grpSig)
dot_color_short = input.color(color.yellow, "Colore Short", group=grpSig)
dot_size_str    = input.string("Normal", "Dimensione",
     options=["Tiny","Small","Normal","Large","Huge"], group=grpSig)
alert_msg_long  = input.string("LONG Signal",  "Messaggio Alert Long",  group=grpSig)
alert_msg_short = input.string("SHORT Signal", "Messaggio Alert Short", group=grpSig)

// ══════════════════════════════════════════════════════════════════════════════
//  CALCOLO EMA
// ══════════════════════════════════════════════════════════════════════════════
ema50  = ta.ema(close, ema50_len)
ema100 = ta.ema(close, ema100_len)
ema150 = ta.ema(close, ema150_len)

// ══════════════════════════════════════════════════════════════════════════════
//  CALCOLO QQE MOD
//  Restituisce la RSI smoothed (rsi_ema). La differenza fast-slow forma
//  l'istogramma: fast > slow = barra verde, fast < slow = barra rossa.
// ══════════════════════════════════════════════════════════════════════════════
f_qqe(len, sm, fac) =>
    rsi   = ta.rsi(close, len)
    rma   = ta.ema(rsi, sm)
    atr   = math.abs(rma[1] - rma)
    matr  = ta.ema(atr, len * 4 - 1)
    delta = ta.ema(matr, len * 4 - 1) * fac
    var float lb = 0.0
    var float sb = 0.0
    var int   tr = 1
    lb := rma > nz(lb[1]) ? math.max(nz(lb[1]), rma - delta) : rma - delta
    sb := rma < nz(sb[1]) ? math.min(nz(sb[1]), rma + delta) : rma + delta
    tr := ta.crossover(rma, sb[1]) ? 1 : ta.crossunder(rma, lb[1]) ? -1 : nz(tr[1], 1)
    rma

rsi_slow = f_qqe(ql1, qs1, qf1)
rsi_fast = f_qqe(ql2, qs2, qf2)

qqe_green = rsi_fast > rsi_slow   // barra verde
qqe_red   = rsi_fast < rsi_slow   // barra rossa

// ══════════════════════════════════════════════════════════════════════════════
//  CONDIZIONI SEGNALE
//
//  [TODO] Trend Meter: in attesa del codice sorgente.
//  Quando disponibile, aggiungere:
//      trend_bull = <tutte le aree Trend Meter verdi>
//      trend_bear = <tutte le aree Trend Meter rosse>
//  e includere nelle righe long_sig / short_sig.
// ══════════════════════════════════════════════════════════════════════════════

// 1. EMA in ordine (possono essere ravvicinate, l'importante è l'ordine)
bull_ema = ema50 > ema100 and ema100 > ema150
bear_ema = ema50 < ema100 and ema100 < ema150

// 2. Prezzo tocca EMA50 (attraversa o rimbalza) e corpo chiude fuori
//    LONG : low tocca/attraversa ema50, corpo intero (min open,close) sopra
bull_touch = low <= ema50 and math.min(open, close) > ema50
//    SHORT: high tocca/attraversa ema50, corpo intero (max open,close) sotto
bear_touch = high >= ema50 and math.max(open, close) < ema50

// 3. QQE MOD: barra verde/rossa
// 4. Trend Meter: TODO (decommentare when trend_bull/trend_bear disponibili)

long_sig  = bull_ema and bull_touch and qqe_green // and trend_bull
short_sig = bear_ema and bear_touch and qqe_red   // and trend_bear

// ══════════════════════════════════════════════════════════════════════════════
//  PLOT EMA
// ══════════════════════════════════════════════════════════════════════════════
plot(show_emas ? ema50  : na, "EMA 50",  color=color.orange, linewidth=2)
plot(show_emas ? ema100 : na, "EMA 100", color=color.yellow, linewidth=2)
plot(show_emas ? ema150 : na, "EMA 150", color=color.white,  linewidth=2)

// ══════════════════════════════════════════════════════════════════════════════
//  PLOT SEGNALI
//  (plotshape richiede size come const: una chiamata per dimensione)
// ══════════════════════════════════════════════════════════════════════════════
plotshape(long_sig  and dot_size_str == "Tiny",   "Long",  shape.circle, location.belowbar, dot_color_long,  size=size.tiny)
plotshape(long_sig  and dot_size_str == "Small",  "Long",  shape.circle, location.belowbar, dot_color_long,  size=size.small)
plotshape(long_sig  and dot_size_str == "Normal", "Long",  shape.circle, location.belowbar, dot_color_long,  size=size.normal)
plotshape(long_sig  and dot_size_str == "Large",  "Long",  shape.circle, location.belowbar, dot_color_long,  size=size.large)
plotshape(long_sig  and dot_size_str == "Huge",   "Long",  shape.circle, location.belowbar, dot_color_long,  size=size.huge)

plotshape(short_sig and dot_size_str == "Tiny",   "Short", shape.circle, location.abovebar, dot_color_short, size=size.tiny)
plotshape(short_sig and dot_size_str == "Small",  "Short", shape.circle, location.abovebar, dot_color_short, size=size.small)
plotshape(short_sig and dot_size_str == "Normal", "Short", shape.circle, location.abovebar, dot_color_short, size=size.normal)
plotshape(short_sig and dot_size_str == "Large",  "Short", shape.circle, location.abovebar, dot_color_short, size=size.large)
plotshape(short_sig and dot_size_str == "Huge",   "Short", shape.circle, location.abovebar, dot_color_short, size=size.huge)

// ══════════════════════════════════════════════════════════════════════════════
//  ALERT
//  Per attivare il suono: Alert → questo indicatore → Long/Short Signal
//                         → Notifiche → spunta Suono → scegli suono
// ══════════════════════════════════════════════════════════════════════════════
alertcondition(long_sig,  "Long Signal",  "LONG: EMA in ordine + tocco EMA50 + QQE verde")
alertcondition(short_sig, "Short Signal", "SHORT: EMA in ordine + tocco EMA50 + QQE rosso")

if long_sig
    alert(alert_msg_long,  alert.freq_once_per_bar)
if short_sig
    alert(alert_msg_short, alert.freq_once_per_bar)
