//@version=5
indicator("My Strategy Signal", overlay=true)

// ═══════════════════════════════════════════════════════════
// IMPOSTAZIONI EMA
// ═══════════════════════════════════════════════════════════
ema50_len  = input.int(50,  title="EMA 50 Length",  group="EMA Settings")
ema100_len = input.int(100, title="EMA 100 Length", group="EMA Settings")
ema150_len = input.int(150, title="EMA 150 Length", group="EMA Settings")

// ═══════════════════════════════════════════════════════════
// IMPOSTAZIONI SEGNALE
// ═══════════════════════════════════════════════════════════
dotColor    = input.color(color.yellow, title="Colore Pallino",                group="Signal Settings")
touchMemory = input.int(10,             title="Memoria tocco EMA50 (candele)", group="Signal Settings", minval=1, maxval=100)

// ═══════════════════════════════════════════════════════════
// IMPOSTAZIONI QQE MOD
// ═══════════════════════════════════════════════════════════
rsiLengthPrimary      = input.int(6,      title="RSI Length Primary",      group="QQE MOD Settings")
rsiSmoothingPrimary   = input.int(5,      title="RSI Smoothing Primary",   group="QQE MOD Settings")
qqeFactorPrimary      = input.float(3.0,  title="QQE Factor Primary",      group="QQE MOD Settings")
rsiLengthSecondary    = input.int(6,      title="RSI Length Secondary",    group="QQE MOD Settings")
rsiSmoothingSecondary = input.int(5,      title="RSI Smoothing Secondary", group="QQE MOD Settings")
qqeFactorSecondary    = input.float(1.61, title="QQE Factor Secondary",    group="QQE MOD Settings")
bollingerLength       = input.int(50,     title="Bollinger Length",         group="QQE MOD Settings")
bollingerMultiplier   = input.float(0.35, title="Bollinger Multiplier",     group="QQE MOD Settings")
thresholdSecondary    = input.float(3.0,  title="Threshold Secondary",      group="QQE MOD Settings")

// ═══════════════════════════════════════════════════════════
// IMPOSTAZIONI TABELLA 7 MAJOR PAIRS
// N.B.: 7 pair × 3 TF = 21 request.security() — limite Pine Script: 40
// I TF sono configurabili: input.timeframe() non aggiunge overhead.
// ═══════════════════════════════════════════════════════════
grpTbl   = "Major Pairs Table"
showTable = input.bool(true,    title="Mostra Tabella",    group=grpTbl)
tf1       = input.timeframe("15",  title="TF 1 (default M15)", group=grpTbl)
tf2       = input.timeframe("60",  title="TF 2 (default H1)",  group=grpTbl)
tf3       = input.timeframe("240", title="TF 3 (default H4)",  group=grpTbl)
tbl_pos   = input.string("Top Right", title="Posizione",
     options=["Top Left","Top Right","Bottom Left","Bottom Right"], group=grpTbl)

// ═══════════════════════════════════════════════════════════
// FUNZIONE QQE
// ═══════════════════════════════════════════════════════════
calculateQQE(rsiLen, smoothing, qqeFactor, src) =>
    wildersLength = rsiLen * 2 - 1
    rsi = ta.rsi(src, rsiLen)
    smoothedRsi = ta.ema(rsi, smoothing)
    atrRsi = math.abs(smoothedRsi[1] - smoothedRsi)
    smoothedAtrRsi = ta.ema(atrRsi, wildersLength)
    dynamicAtrRsi = smoothedAtrRsi * qqeFactor
    longBand  = 0.0
    shortBand = 0.0
    trendDir  = 0
    longBand  := smoothedRsi[1] > longBand[1]  and smoothedRsi > longBand[1]  ? math.max(longBand[1],  smoothedRsi - dynamicAtrRsi) : smoothedRsi - dynamicAtrRsi
    shortBand := smoothedRsi[1] < shortBand[1] and smoothedRsi < shortBand[1] ? math.min(shortBand[1], smoothedRsi + dynamicAtrRsi) : smoothedRsi + dynamicAtrRsi
    if ta.cross(smoothedRsi, shortBand[1])
        trendDir := 1
    else if ta.cross(longBand[1], smoothedRsi)
        trendDir := -1
    else
        trendDir := trendDir[1]
    smoothedRsi

// ═══════════════════════════════════════════════════════════
// FUNZIONE SEGNALE COMPLETO
// ═══════════════════════════════════════════════════════════
calcAll() =>
    e50  = ta.ema(close, ema50_len)
    e100 = ta.ema(close, ema100_len)
    e150 = ta.ema(close, ema150_len)
    emaL = e50 > e100 and e100 > e150
    emaS = e50 < e100 and e100 < e150
    tL = low <= e50 and open > e50 and close > e50 and emaL
    tS = high >= e50 and open < e50 and close < e50 and emaS
    bsL = ta.barssince(tL)
    bsS = ta.barssince(tS)
    pRSI = calculateQQE(rsiLengthPrimary,   rsiSmoothingPrimary,   qqeFactorPrimary,   close)
    sRSI = calculateQQE(rsiLengthSecondary, rsiSmoothingSecondary, qqeFactorSecondary, close)
    bbBasis = ta.sma(pRSI - 50, bollingerLength)
    bbDev   = bollingerMultiplier * ta.stdev(pRSI - 50, bollingerLength)
    bbU     = bbBasis + bbDev
    bbL2    = bbBasis - bbDev
    qqeL = (sRSI - 50) >  thresholdSecondary and (pRSI - 50) >  bbU
    qqeS = (sRSI - 50) < -thresholdSecondary and (pRSI - 50) <  bbL2
    fMLine = ta.ema(close, 8) - ta.ema(close, 21)
    fSLine = ta.ema(fMLine, 5)
    tm1 = (fMLine - fSLine) > 0
    tm2 = ta.rsi(close, 13) > 50
    tm3 = ta.rsi(close, 5)  > 50
    t1  = ta.ema(close, 5)  > ta.ema(close, 11)
    t2  = ta.ema(close, 13) > ta.sma(close, 36)
    trendL = tm1 and tm2 and tm3 and t1 and t2
    trendS = not tm1 and not tm2 and not tm3 and not t1 and not t2
    [bsL, bsS, close, e50, emaL, emaS, qqeL, qqeS, trendL, trendS]

evalSignal(bsL, bsS, c, e50, emaL, emaS, qqeL, qqeS, trendL, trendS, mem) =>
    tmL = bsL <= mem and c > e50
    tmS = bsS <= mem and c < e50
    sigL = emaL and tmL and qqeL and trendL
    sigS = emaS and tmS and qqeS and trendS
    sigL ? 1 : sigS ? -1 : 0

// ═══════════════════════════════════════════════════════════
// SEGNALE CHART CORRENTE
// ═══════════════════════════════════════════════════════════
[bsL0, bsS0, c0, e500, emaL0, emaS0, qqeL0, qqeS0, trendL0, trendS0] = calcAll()

sig0     = evalSignal(bsL0, bsS0, c0, e500, emaL0, emaS0, qqeL0, qqeS0, trendL0, trendS0, touchMemory)
sig0prev = evalSignal(bsL0[1], bsS0[1], c0[1], e500[1], emaL0[1], emaS0[1], qqeL0[1], qqeS0[1], trendL0[1], trendS0[1], touchMemory)

signalLongNew  = sig0 == 1  and sig0prev != 1
signalShortNew = sig0 == -1 and sig0prev != -1

// ═══════════════════════════════════════════════════════════
// PLOT PALLINO
// ═══════════════════════════════════════════════════════════
plotshape(signalLongNew,  title="Segnale LONG",  location=location.belowbar, style=shape.circle, color=dotColor, size=size.normal)
plotshape(signalShortNew, title="Segnale SHORT", location=location.abovebar, style=shape.circle, color=dotColor, size=size.normal)

// ═══════════════════════════════════════════════════════════
// REQUEST.SECURITY — 7 pair × 3 TF = 21 chiamate
// ═══════════════════════════════════════════════════════════
f_get(sym, tf) =>
    [a, b, c, d, e, f, g, h, ii, j] = request.security(sym, tf, calcAll(), lookahead=barmerge.lookahead_off)
    evalSignal(a, b, c, d, e, f, g, h, ii, j, touchMemory)

// EURUSD
eu_t1 = f_get("EURUSD", tf1)
eu_t2 = f_get("EURUSD", tf2)
eu_t3 = f_get("EURUSD", tf3)

// GBPUSD
gu_t1 = f_get("GBPUSD", tf1)
gu_t2 = f_get("GBPUSD", tf2)
gu_t3 = f_get("GBPUSD", tf3)

// USDJPY
uj_t1 = f_get("USDJPY", tf1)
uj_t2 = f_get("USDJPY", tf2)
uj_t3 = f_get("USDJPY", tf3)

// USDCHF
uc_t1 = f_get("USDCHF", tf1)
uc_t2 = f_get("USDCHF", tf2)
uc_t3 = f_get("USDCHF", tf3)

// USDCAD
ud_t1 = f_get("USDCAD", tf1)
ud_t2 = f_get("USDCAD", tf2)
ud_t3 = f_get("USDCAD", tf3)

// AUDUSD
au_t1 = f_get("AUDUSD", tf1)
au_t2 = f_get("AUDUSD", tf2)
au_t3 = f_get("AUDUSD", tf3)

// NZDUSD
nz_t1 = f_get("NZDUSD", tf1)
nz_t2 = f_get("NZDUSD", tf2)
nz_t3 = f_get("NZDUSD", tf3)

// ═══════════════════════════════════════════════════════════
// TABELLA 7 MAJOR PAIRS
// ═══════════════════════════════════════════════════════════
tfLabel(lbl) =>
    switch lbl
        "1"   => "M1"
        "3"   => "M3"
        "5"   => "M5"
        "10"  => "M10"
        "15"  => "M15"
        "30"  => "M30"
        "45"  => "M45"
        "60"  => "H1"
        "120" => "H2"
        "180" => "H3"
        "240" => "H4"
        "D"   => "D1"
        "W"   => "W1"
        "M"   => "MN"
        =>       lbl

cellBg(sig)  => sig == 1 ? color.new(color.green, 75) : sig == -1 ? color.new(color.red, 75) : color.new(color.black, 70)
cellTxt(sig) => sig != 0 ? "●" : "○"
cellCol(sig) => sig != 0 ? color.yellow : color.new(color.gray, 50)

C_HEAD = color.new(color.gray, 60)
C_TXT  = color.white

tbl_position = switch tbl_pos
    "Top Left"     => position.top_left
    "Top Right"    => position.top_right
    "Bottom Left"  => position.bottom_left
    =>               position.bottom_right

var table mtfTable = na

if showTable and barstate.islast
    // 4 colonne: nome pair + 3 TF  |  8 righe: header + 7 pair
    mtfTable := table.new(tbl_position, 4, 8,
         border_width=1, border_color=color.new(color.gray, 50),
         frame_width=1,  frame_color=color.new(color.gray, 40))

    // Header
    table.cell(mtfTable, 0, 0, "Pair",          bgcolor=C_HEAD, text_color=C_TXT, text_size=size.small, text_halign=text.align_center)
    table.cell(mtfTable, 1, 0, tfLabel(tf1),    bgcolor=C_HEAD, text_color=C_TXT, text_size=size.small, text_halign=text.align_center)
    table.cell(mtfTable, 2, 0, tfLabel(tf2),    bgcolor=C_HEAD, text_color=C_TXT, text_size=size.small, text_halign=text.align_center)
    table.cell(mtfTable, 3, 0, tfLabel(tf3),    bgcolor=C_HEAD, text_color=C_TXT, text_size=size.small, text_halign=text.align_center)

    // EURUSD
    table.cell(mtfTable, 0, 1, "EURUSD", bgcolor=C_HEAD, text_color=C_TXT, text_size=size.small)
    table.cell(mtfTable, 1, 1, cellTxt(eu_t1), text_color=cellCol(eu_t1), bgcolor=cellBg(eu_t1), text_size=size.normal, text_halign=text.align_center)
    table.cell(mtfTable, 2, 1, cellTxt(eu_t2), text_color=cellCol(eu_t2), bgcolor=cellBg(eu_t2), text_size=size.normal, text_halign=text.align_center)
    table.cell(mtfTable, 3, 1, cellTxt(eu_t3), text_color=cellCol(eu_t3), bgcolor=cellBg(eu_t3), text_size=size.normal, text_halign=text.align_center)

    // GBPUSD
    table.cell(mtfTable, 0, 2, "GBPUSD", bgcolor=C_HEAD, text_color=C_TXT, text_size=size.small)
    table.cell(mtfTable, 1, 2, cellTxt(gu_t1), text_color=cellCol(gu_t1), bgcolor=cellBg(gu_t1), text_size=size.normal, text_halign=text.align_center)
    table.cell(mtfTable, 2, 2, cellTxt(gu_t2), text_color=cellCol(gu_t2), bgcolor=cellBg(gu_t2), text_size=size.normal, text_halign=text.align_center)
    table.cell(mtfTable, 3, 2, cellTxt(gu_t3), text_color=cellCol(gu_t3), bgcolor=cellBg(gu_t3), text_size=size.normal, text_halign=text.align_center)

    // USDJPY
    table.cell(mtfTable, 0, 3, "USDJPY", bgcolor=C_HEAD, text_color=C_TXT, text_size=size.small)
    table.cell(mtfTable, 1, 3, cellTxt(uj_t1), text_color=cellCol(uj_t1), bgcolor=cellBg(uj_t1), text_size=size.normal, text_halign=text.align_center)
    table.cell(mtfTable, 2, 3, cellTxt(uj_t2), text_color=cellCol(uj_t2), bgcolor=cellBg(uj_t2), text_size=size.normal, text_halign=text.align_center)
    table.cell(mtfTable, 3, 3, cellTxt(uj_t3), text_color=cellCol(uj_t3), bgcolor=cellBg(uj_t3), text_size=size.normal, text_halign=text.align_center)

    // USDCHF
    table.cell(mtfTable, 0, 4, "USDCHF", bgcolor=C_HEAD, text_color=C_TXT, text_size=size.small)
    table.cell(mtfTable, 1, 4, cellTxt(uc_t1), text_color=cellCol(uc_t1), bgcolor=cellBg(uc_t1), text_size=size.normal, text_halign=text.align_center)
    table.cell(mtfTable, 2, 4, cellTxt(uc_t2), text_color=cellCol(uc_t2), bgcolor=cellBg(uc_t2), text_size=size.normal, text_halign=text.align_center)
    table.cell(mtfTable, 3, 4, cellTxt(uc_t3), text_color=cellCol(uc_t3), bgcolor=cellBg(uc_t3), text_size=size.normal, text_halign=text.align_center)

    // USDCAD
    table.cell(mtfTable, 0, 5, "USDCAD", bgcolor=C_HEAD, text_color=C_TXT, text_size=size.small)
    table.cell(mtfTable, 1, 5, cellTxt(ud_t1), text_color=cellCol(ud_t1), bgcolor=cellBg(ud_t1), text_size=size.normal, text_halign=text.align_center)
    table.cell(mtfTable, 2, 5, cellTxt(ud_t2), text_color=cellCol(ud_t2), bgcolor=cellBg(ud_t2), text_size=size.normal, text_halign=text.align_center)
    table.cell(mtfTable, 3, 5, cellTxt(ud_t3), text_color=cellCol(ud_t3), bgcolor=cellBg(ud_t3), text_size=size.normal, text_halign=text.align_center)

    // AUDUSD
    table.cell(mtfTable, 0, 6, "AUDUSD", bgcolor=C_HEAD, text_color=C_TXT, text_size=size.small)
    table.cell(mtfTable, 1, 6, cellTxt(au_t1), text_color=cellCol(au_t1), bgcolor=cellBg(au_t1), text_size=size.normal, text_halign=text.align_center)
    table.cell(mtfTable, 2, 6, cellTxt(au_t2), text_color=cellCol(au_t2), bgcolor=cellBg(au_t2), text_size=size.normal, text_halign=text.align_center)
    table.cell(mtfTable, 3, 6, cellTxt(au_t3), text_color=cellCol(au_t3), bgcolor=cellBg(au_t3), text_size=size.normal, text_halign=text.align_center)

    // NZDUSD
    table.cell(mtfTable, 0, 7, "NZDUSD", bgcolor=C_HEAD, text_color=C_TXT, text_size=size.small)
    table.cell(mtfTable, 1, 7, cellTxt(nz_t1), text_color=cellCol(nz_t1), bgcolor=cellBg(nz_t1), text_size=size.normal, text_halign=text.align_center)
    table.cell(mtfTable, 2, 7, cellTxt(nz_t2), text_color=cellCol(nz_t2), bgcolor=cellBg(nz_t2), text_size=size.normal, text_halign=text.align_center)
    table.cell(mtfTable, 3, 7, cellTxt(nz_t3), text_color=cellCol(nz_t3), bgcolor=cellBg(nz_t3), text_size=size.normal, text_halign=text.align_center)

// ═══════════════════════════════════════════════════════════
// ALERT
// ═══════════════════════════════════════════════════════════
alertcondition(signalLongNew,                   title="Segnale LONG",         message="MY STRATEGY - LONG")
alertcondition(signalShortNew,                  title="Segnale SHORT",        message="MY STRATEGY - SHORT")
alertcondition(signalLongNew or signalShortNew, title="Segnale LONG o SHORT", message="MY STRATEGY - SEGNALE")
