//@version=5
indicator("My Strategy Signal", overlay=true)

// ══════════════════════════════════════════════════════════════════════════════
//  INPUTS — EMA
// ══════════════════════════════════════════════════════════════════════════════
grpMA      = "EMA"
ema50_len  = input.int(50,  "EMA 50",  minval=1, group=grpMA)
ema100_len = input.int(100, "EMA 100", minval=1, group=grpMA)
ema150_len = input.int(150, "EMA 150", minval=1, group=grpMA)
show_emas  = input.bool(true, "Mostra EMA", group=grpMA)

// ══════════════════════════════════════════════════════════════════════════════
//  INPUTS — QQE MOD
// ══════════════════════════════════════════════════════════════════════════════
grpQQE                = "QQE MOD"
rsiLengthPrimary      = input.int(6,     "RSI Length (Primario)",     minval=1,   group=grpQQE)
rsiSmoothingPrimary   = input.int(5,     "RSI Smooth (Primario)",     minval=1,   group=grpQQE)
qqeFactorPrimary      = input.float(4.238, "QQE Factor (Primario)",   minval=0.1, group=grpQQE)
bollingerLength       = input.int(50,    "Bollinger Length",           minval=1,   group=grpQQE)
bollingerMultiplier   = input.float(0.35, "Bollinger Multiplier",     minval=0.01,group=grpQQE)
rsiLengthSecondary    = input.int(3,     "RSI Length (Secondario)",   minval=1,   group=grpQQE)
rsiSmoothingSecondary = input.int(3,     "RSI Smooth (Secondario)",   minval=1,   group=grpQQE)
qqeFactorSecondary    = input.float(1.618, "QQE Factor (Secondario)", minval=0.1, group=grpQQE)
thresholdSecondary    = input.float(0,   "Threshold Secondario",                  group=grpQQE)

// ══════════════════════════════════════════════════════════════════════════════
//  INPUTS — SEGNALE
// ══════════════════════════════════════════════════════════════════════════════
grpSig          = "Segnale"
mem             = input.int(3,  "Touch Memory (barre)", minval=1, group=grpSig)
alert_msg_long  = input.string("LONG Signal",  "Alert Long",  group=grpSig)
alert_msg_short = input.string("SHORT Signal", "Alert Short", group=grpSig)

// ══════════════════════════════════════════════════════════════════════════════
//  INPUTS — TABELLA MAJOR PAIRS
//  N.B.: 7 pair × 5 TF = 35 request.security() (limite Pine Script: 40)
//        Con 6 TF si arriverebbe a 42, superando il limite → usare 5 TF.
// ══════════════════════════════════════════════════════════════════════════════
grpTbl  = "Tabella Major Pairs"
tf1     = input.timeframe("1",   "TF 1", group=grpTbl)
tf2     = input.timeframe("5",   "TF 2", group=grpTbl)
tf3     = input.timeframe("15",  "TF 3", group=grpTbl)
tf4     = input.timeframe("60",  "TF 4", group=grpTbl)
tf5     = input.timeframe("240", "TF 5", group=grpTbl)
tbl_pos = input.string("Bottom Right", "Posizione Tabella",
     options=["Top Left","Top Right","Bottom Left","Bottom Right"], group=grpTbl)

// ══════════════════════════════════════════════════════════════════════════════
//  PLOT EMA
// ══════════════════════════════════════════════════════════════════════════════
plot(show_emas ? ta.ema(close, ema50_len)  : na, "EMA 50",  color=color.orange, linewidth=2)
plot(show_emas ? ta.ema(close, ema100_len) : na, "EMA 100", color=color.yellow, linewidth=2)
plot(show_emas ? ta.ema(close, ema150_len) : na, "EMA 150", color=color.white,  linewidth=2)

// ══════════════════════════════════════════════════════════════════════════════
//  FUNZIONI SEGNALE  ← non modificare
// ══════════════════════════════════════════════════════════════════════════════
calculateQQE(rsiLen, smoothing, qqeFactor, src) =>
    wildersLength = rsiLen * 2 - 1
    rsi = ta.rsi(src, rsiLen)
    smoothedRsi = ta.ema(rsi, smoothing)
    atrRsi = math.abs(smoothedRsi[1] - smoothedRsi)
    smoothedAtrRsi = ta.ema(atrRsi, wildersLength)
    dynamicAtrRsi = smoothedAtrRsi * qqeFactor
    longBand  = 0.0
    shortBand = 0.0
    trendDir  = 0
    longBand  := smoothedRsi[1] > longBand[1]  and smoothedRsi > longBand[1]  ? math.max(longBand[1],  smoothedRsi - dynamicAtrRsi) : smoothedRsi - dynamicAtrRsi
    shortBand := smoothedRsi[1] < shortBand[1] and smoothedRsi < shortBand[1] ? math.min(shortBand[1], smoothedRsi + dynamicAtrRsi) : smoothedRsi + dynamicAtrRsi
    if ta.cross(smoothedRsi, shortBand[1])
        trendDir := 1
    else if ta.cross(longBand[1], smoothedRsi)
        trendDir := -1
    else
        trendDir := trendDir[1]
    smoothedRsi

calcAll() =>
    e50  = ta.ema(close, ema50_len)
    e100 = ta.ema(close, ema100_len)
    e150 = ta.ema(close, ema150_len)
    emaL = e50 > e100 and e100 > e150
    emaS = e50 < e100 and e100 < e150
    tL = low <= e50 and open > e50 and close > e50 and emaL
    tS = high >= e50 and open < e50 and close < e50 and emaS
    bsL = ta.barssince(tL)
    bsS = ta.barssince(tS)
    pRSI = calculateQQE(rsiLengthPrimary,   rsiSmoothingPrimary,   qqeFactorPrimary,   close)
    sRSI = calculateQQE(rsiLengthSecondary, rsiSmoothingSecondary, qqeFactorSecondary, close)
    bbBasis = ta.sma(pRSI - 50, bollingerLength)
    bbDev   = bollingerMultiplier * ta.stdev(pRSI - 50, bollingerLength)
    bbU     = bbBasis + bbDev
    bbL2    = bbBasis - bbDev
    qqeL = (sRSI - 50) >  thresholdSecondary and (pRSI - 50) >  bbU
    qqeS = (sRSI - 50) < -thresholdSecondary and (pRSI - 50) <  bbL2
    fMLine = ta.ema(close, 8) - ta.ema(close, 21)
    fSLine = ta.ema(fMLine, 5)
    tm1 = (fMLine - fSLine) > 0
    tm2 = ta.rsi(close, 13) > 50
    tm3 = ta.rsi(close, 5)  > 50
    t1  = ta.ema(close, 5)  > ta.ema(close, 11)
    t2  = ta.ema(close, 13) > ta.sma(close, 36)
    trendL = tm1 and tm2 and tm3 and t1 and t2
    trendS = not tm1 and not tm2 and not tm3 and not t1 and not t2
    [bsL, bsS, close, e50, emaL, emaS, qqeL, qqeS, trendL, trendS]

evalSignal(bsL, bsS, c, e50, emaL, emaS, qqeL, qqeS, trendL, trendS, mem) =>
    tmL = bsL <= mem and c > e50
    tmS = bsS <= mem and c < e50
    sigL = emaL and tmL and qqeL and trendL
    sigS = emaS and tmS and qqeS and trendS
    sigL ? 1 : sigS ? -1 : 0

// ══════════════════════════════════════════════════════════════════════════════
//  SEGNALE CHART CORRENTE  (usato per gli alert)
// ══════════════════════════════════════════════════════════════════════════════
[bsL0, bsS0, c0, e50_0, emaL0, emaS0, qqeL0, qqeS0, trendL0, trendS0] = calcAll()
curSig    = evalSignal(bsL0, bsS0, c0, e50_0, emaL0, emaS0, qqeL0, qqeS0, trendL0, trendS0, mem)
long_sig  = curSig == 1
short_sig = curSig == -1

// ══════════════════════════════════════════════════════════════════════════════
//  REQUEST.SECURITY — 7 pair × 5 TF = 35 chiamate (< limite 40)
// ══════════════════════════════════════════════════════════════════════════════
f_get(sym, tf) =>
    [a, b, c, d, e, f, g, h, ii, j] = request.security(sym, tf, calcAll())
    evalSignal(a, b, c, d, e, f, g, h, ii, j, mem)

// EURUSD
eu_t1 = f_get("EURUSD", tf1)
eu_t2 = f_get("EURUSD", tf2)
eu_t3 = f_get("EURUSD", tf3)
eu_t4 = f_get("EURUSD", tf4)
eu_t5 = f_get("EURUSD", tf5)

// GBPUSD
gu_t1 = f_get("GBPUSD", tf1)
gu_t2 = f_get("GBPUSD", tf2)
gu_t3 = f_get("GBPUSD", tf3)
gu_t4 = f_get("GBPUSD", tf4)
gu_t5 = f_get("GBPUSD", tf5)

// USDJPY
uj_t1 = f_get("USDJPY", tf1)
uj_t2 = f_get("USDJPY", tf2)
uj_t3 = f_get("USDJPY", tf3)
uj_t4 = f_get("USDJPY", tf4)
uj_t5 = f_get("USDJPY", tf5)

// USDCHF
uc_t1 = f_get("USDCHF", tf1)
uc_t2 = f_get("USDCHF", tf2)
uc_t3 = f_get("USDCHF", tf3)
uc_t4 = f_get("USDCHF", tf4)
uc_t5 = f_get("USDCHF", tf5)

// USDCAD
ud_t1 = f_get("USDCAD", tf1)
ud_t2 = f_get("USDCAD", tf2)
ud_t3 = f_get("USDCAD", tf3)
ud_t4 = f_get("USDCAD", tf4)
ud_t5 = f_get("USDCAD", tf5)

// AUDUSD
au_t1 = f_get("AUDUSD", tf1)
au_t2 = f_get("AUDUSD", tf2)
au_t3 = f_get("AUDUSD", tf3)
au_t4 = f_get("AUDUSD", tf4)
au_t5 = f_get("AUDUSD", tf5)

// NZDUSD
nz_t1 = f_get("NZDUSD", tf1)
nz_t2 = f_get("NZDUSD", tf2)
nz_t3 = f_get("NZDUSD", tf3)
nz_t4 = f_get("NZDUSD", tf4)
nz_t5 = f_get("NZDUSD", tf5)

// ══════════════════════════════════════════════════════════════════════════════
//  TABELLA
// ══════════════════════════════════════════════════════════════════════════════
C_HEAD  = color.new(color.gray,  20)
C_BG    = color.new(color.gray,  80)
C_LONG  = color.new(color.green, 20)
C_SHORT = color.new(color.red,   20)
C_TXT   = color.white
C_DOT   = color.yellow

f_tf_label(tf) =>
    switch tf
        "1"   => "M1"
        "3"   => "M3"
        "5"   => "M5"
        "10"  => "M10"
        "15"  => "M15"
        "30"  => "M30"
        "45"  => "M45"
        "60"  => "H1"
        "120" => "H2"
        "180" => "H3"
        "240" => "H4"
        "D"   => "D1"
        "W"   => "W1"
        "M"   => "MN"
        =>       tf

tbl_position = switch tbl_pos
    "Top Left"     => position.top_left
    "Top Right"    => position.top_right
    "Bottom Left"  => position.bottom_left
    =>               position.bottom_right

var table tbl = na

if barstate.islast
    tbl := table.new(tbl_position, 6, 8,
         border_width=1,
         border_color=color.new(color.gray, 50),
         frame_width=1,
         frame_color=color.new(color.gray, 30))

    // ── Intestazione colonne ──────────────────────────────────────────────────
    table.cell(tbl, 0, 0, "Pair",
         bgcolor=C_HEAD, text_color=C_TXT, text_size=size.small, text_halign=text.align_center)
    table.cell(tbl, 1, 0, f_tf_label(tf1),
         bgcolor=C_HEAD, text_color=C_TXT, text_size=size.small, text_halign=text.align_center)
    table.cell(tbl, 2, 0, f_tf_label(tf2),
         bgcolor=C_HEAD, text_color=C_TXT, text_size=size.small, text_halign=text.align_center)
    table.cell(tbl, 3, 0, f_tf_label(tf3),
         bgcolor=C_HEAD, text_color=C_TXT, text_size=size.small, text_halign=text.align_center)
    table.cell(tbl, 4, 0, f_tf_label(tf4),
         bgcolor=C_HEAD, text_color=C_TXT, text_size=size.small, text_halign=text.align_center)
    table.cell(tbl, 5, 0, f_tf_label(tf5),
         bgcolor=C_HEAD, text_color=C_TXT, text_size=size.small, text_halign=text.align_center)

    // ── Riga 1: EURUSD ────────────────────────────────────────────────────────
    table.cell(tbl, 0, 1, "EURUSD", bgcolor=C_HEAD, text_color=C_TXT, text_size=size.small)
    table.cell(tbl, 1, 1, eu_t1 != 0 ? "●" : "", bgcolor=eu_t1 == 1 ? C_LONG : eu_t1 == -1 ? C_SHORT : C_BG, text_color=C_DOT, text_size=size.normal, text_halign=text.align_center)
    table.cell(tbl, 2, 1, eu_t2 != 0 ? "●" : "", bgcolor=eu_t2 == 1 ? C_LONG : eu_t2 == -1 ? C_SHORT : C_BG, text_color=C_DOT, text_size=size.normal, text_halign=text.align_center)
    table.cell(tbl, 3, 1, eu_t3 != 0 ? "●" : "", bgcolor=eu_t3 == 1 ? C_LONG : eu_t3 == -1 ? C_SHORT : C_BG, text_color=C_DOT, text_size=size.normal, text_halign=text.align_center)
    table.cell(tbl, 4, 1, eu_t4 != 0 ? "●" : "", bgcolor=eu_t4 == 1 ? C_LONG : eu_t4 == -1 ? C_SHORT : C_BG, text_color=C_DOT, text_size=size.normal, text_halign=text.align_center)
    table.cell(tbl, 5, 1, eu_t5 != 0 ? "●" : "", bgcolor=eu_t5 == 1 ? C_LONG : eu_t5 == -1 ? C_SHORT : C_BG, text_color=C_DOT, text_size=size.normal, text_halign=text.align_center)

    // ── Riga 2: GBPUSD ────────────────────────────────────────────────────────
    table.cell(tbl, 0, 2, "GBPUSD", bgcolor=C_HEAD, text_color=C_TXT, text_size=size.small)
    table.cell(tbl, 1, 2, gu_t1 != 0 ? "●" : "", bgcolor=gu_t1 == 1 ? C_LONG : gu_t1 == -1 ? C_SHORT : C_BG, text_color=C_DOT, text_size=size.normal, text_halign=text.align_center)
    table.cell(tbl, 2, 2, gu_t2 != 0 ? "●" : "", bgcolor=gu_t2 == 1 ? C_LONG : gu_t2 == -1 ? C_SHORT : C_BG, text_color=C_DOT, text_size=size.normal, text_halign=text.align_center)
    table.cell(tbl, 3, 2, gu_t3 != 0 ? "●" : "", bgcolor=gu_t3 == 1 ? C_LONG : gu_t3 == -1 ? C_SHORT : C_BG, text_color=C_DOT, text_size=size.normal, text_halign=text.align_center)
    table.cell(tbl, 4, 2, gu_t4 != 0 ? "●" : "", bgcolor=gu_t4 == 1 ? C_LONG : gu_t4 == -1 ? C_SHORT : C_BG, text_color=C_DOT, text_size=size.normal, text_halign=text.align_center)
    table.cell(tbl, 5, 2, gu_t5 != 0 ? "●" : "", bgcolor=gu_t5 == 1 ? C_LONG : gu_t5 == -1 ? C_SHORT : C_BG, text_color=C_DOT, text_size=size.normal, text_halign=text.align_center)

    // ── Riga 3: USDJPY ────────────────────────────────────────────────────────
    table.cell(tbl, 0, 3, "USDJPY", bgcolor=C_HEAD, text_color=C_TXT, text_size=size.small)
    table.cell(tbl, 1, 3, uj_t1 != 0 ? "●" : "", bgcolor=uj_t1 == 1 ? C_LONG : uj_t1 == -1 ? C_SHORT : C_BG, text_color=C_DOT, text_size=size.normal, text_halign=text.align_center)
    table.cell(tbl, 2, 3, uj_t2 != 0 ? "●" : "", bgcolor=uj_t2 == 1 ? C_LONG : uj_t2 == -1 ? C_SHORT : C_BG, text_color=C_DOT, text_size=size.normal, text_halign=text.align_center)
    table.cell(tbl, 3, 3, uj_t3 != 0 ? "●" : "", bgcolor=uj_t3 == 1 ? C_LONG : uj_t3 == -1 ? C_SHORT : C_BG, text_color=C_DOT, text_size=size.normal, text_halign=text.align_center)
    table.cell(tbl, 4, 3, uj_t4 != 0 ? "●" : "", bgcolor=uj_t4 == 1 ? C_LONG : uj_t4 == -1 ? C_SHORT : C_BG, text_color=C_DOT, text_size=size.normal, text_halign=text.align_center)
    table.cell(tbl, 5, 3, uj_t5 != 0 ? "●" : "", bgcolor=uj_t5 == 1 ? C_LONG : uj_t5 == -1 ? C_SHORT : C_BG, text_color=C_DOT, text_size=size.normal, text_halign=text.align_center)

    // ── Riga 4: USDCHF ────────────────────────────────────────────────────────
    table.cell(tbl, 0, 4, "USDCHF", bgcolor=C_HEAD, text_color=C_TXT, text_size=size.small)
    table.cell(tbl, 1, 4, uc_t1 != 0 ? "●" : "", bgcolor=uc_t1 == 1 ? C_LONG : uc_t1 == -1 ? C_SHORT : C_BG, text_color=C_DOT, text_size=size.normal, text_halign=text.align_center)
    table.cell(tbl, 2, 4, uc_t2 != 0 ? "●" : "", bgcolor=uc_t2 == 1 ? C_LONG : uc_t2 == -1 ? C_SHORT : C_BG, text_color=C_DOT, text_size=size.normal, text_halign=text.align_center)
    table.cell(tbl, 3, 4, uc_t3 != 0 ? "●" : "", bgcolor=uc_t3 == 1 ? C_LONG : uc_t3 == -1 ? C_SHORT : C_BG, text_color=C_DOT, text_size=size.normal, text_halign=text.align_center)
    table.cell(tbl, 4, 4, uc_t4 != 0 ? "●" : "", bgcolor=uc_t4 == 1 ? C_LONG : uc_t4 == -1 ? C_SHORT : C_BG, text_color=C_DOT, text_size=size.normal, text_halign=text.align_center)
    table.cell(tbl, 5, 4, uc_t5 != 0 ? "●" : "", bgcolor=uc_t5 == 1 ? C_LONG : uc_t5 == -1 ? C_SHORT : C_BG, text_color=C_DOT, text_size=size.normal, text_halign=text.align_center)

    // ── Riga 5: USDCAD ────────────────────────────────────────────────────────
    table.cell(tbl, 0, 5, "USDCAD", bgcolor=C_HEAD, text_color=C_TXT, text_size=size.small)
    table.cell(tbl, 1, 5, ud_t1 != 0 ? "●" : "", bgcolor=ud_t1 == 1 ? C_LONG : ud_t1 == -1 ? C_SHORT : C_BG, text_color=C_DOT, text_size=size.normal, text_halign=text.align_center)
    table.cell(tbl, 2, 5, ud_t2 != 0 ? "●" : "", bgcolor=ud_t2 == 1 ? C_LONG : ud_t2 == -1 ? C_SHORT : C_BG, text_color=C_DOT, text_size=size.normal, text_halign=text.align_center)
    table.cell(tbl, 3, 5, ud_t3 != 0 ? "●" : "", bgcolor=ud_t3 == 1 ? C_LONG : ud_t3 == -1 ? C_SHORT : C_BG, text_color=C_DOT, text_size=size.normal, text_halign=text.align_center)
    table.cell(tbl, 4, 5, ud_t4 != 0 ? "●" : "", bgcolor=ud_t4 == 1 ? C_LONG : ud_t4 == -1 ? C_SHORT : C_BG, text_color=C_DOT, text_size=size.normal, text_halign=text.align_center)
    table.cell(tbl, 5, 5, ud_t5 != 0 ? "●" : "", bgcolor=ud_t5 == 1 ? C_LONG : ud_t5 == -1 ? C_SHORT : C_BG, text_color=C_DOT, text_size=size.normal, text_halign=text.align_center)

    // ── Riga 6: AUDUSD ────────────────────────────────────────────────────────
    table.cell(tbl, 0, 6, "AUDUSD", bgcolor=C_HEAD, text_color=C_TXT, text_size=size.small)
    table.cell(tbl, 1, 6, au_t1 != 0 ? "●" : "", bgcolor=au_t1 == 1 ? C_LONG : au_t1 == -1 ? C_SHORT : C_BG, text_color=C_DOT, text_size=size.normal, text_halign=text.align_center)
    table.cell(tbl, 2, 6, au_t2 != 0 ? "●" : "", bgcolor=au_t2 == 1 ? C_LONG : au_t2 == -1 ? C_SHORT : C_BG, text_color=C_DOT, text_size=size.normal, text_halign=text.align_center)
    table.cell(tbl, 3, 6, au_t3 != 0 ? "●" : "", bgcolor=au_t3 == 1 ? C_LONG : au_t3 == -1 ? C_SHORT : C_BG, text_color=C_DOT, text_size=size.normal, text_halign=text.align_center)
    table.cell(tbl, 4, 6, au_t4 != 0 ? "●" : "", bgcolor=au_t4 == 1 ? C_LONG : au_t4 == -1 ? C_SHORT : C_BG, text_color=C_DOT, text_size=size.normal, text_halign=text.align_center)
    table.cell(tbl, 5, 6, au_t5 != 0 ? "●" : "", bgcolor=au_t5 == 1 ? C_LONG : au_t5 == -1 ? C_SHORT : C_BG, text_color=C_DOT, text_size=size.normal, text_halign=text.align_center)

    // ── Riga 7: NZDUSD ────────────────────────────────────────────────────────
    table.cell(tbl, 0, 7, "NZDUSD", bgcolor=C_HEAD, text_color=C_TXT, text_size=size.small)
    table.cell(tbl, 1, 7, nz_t1 != 0 ? "●" : "", bgcolor=nz_t1 == 1 ? C_LONG : nz_t1 == -1 ? C_SHORT : C_BG, text_color=C_DOT, text_size=size.normal, text_halign=text.align_center)
    table.cell(tbl, 2, 7, nz_t2 != 0 ? "●" : "", bgcolor=nz_t2 == 1 ? C_LONG : nz_t2 == -1 ? C_SHORT : C_BG, text_color=C_DOT, text_size=size.normal, text_halign=text.align_center)
    table.cell(tbl, 3, 7, nz_t3 != 0 ? "●" : "", bgcolor=nz_t3 == 1 ? C_LONG : nz_t3 == -1 ? C_SHORT : C_BG, text_color=C_DOT, text_size=size.normal, text_halign=text.align_center)
    table.cell(tbl, 4, 7, nz_t4 != 0 ? "●" : "", bgcolor=nz_t4 == 1 ? C_LONG : nz_t4 == -1 ? C_SHORT : C_BG, text_color=C_DOT, text_size=size.normal, text_halign=text.align_center)
    table.cell(tbl, 5, 7, nz_t5 != 0 ? "●" : "", bgcolor=nz_t5 == 1 ? C_LONG : nz_t5 == -1 ? C_SHORT : C_BG, text_color=C_DOT, text_size=size.normal, text_halign=text.align_center)

// ══════════════════════════════════════════════════════════════════════════════
//  ALERT — chart corrente
// ══════════════════════════════════════════════════════════════════════════════
alertcondition(long_sig,  "Long Signal",  "LONG: EMA in ordine + tocco EMA50 + QQE verde + Trend Meter verde")
alertcondition(short_sig, "Short Signal", "SHORT: EMA in ordine + tocco EMA50 + QQE rosso + Trend Meter rosso")

if long_sig
    alert(alert_msg_long,  alert.freq_once_per_bar)
if short_sig
    alert(alert_msg_short, alert.freq_once_per_bar)
